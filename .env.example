# Copy to .env and replace the token. .env is gitignored.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
PORT=8080
TASKMAN_ACCESS_TOKEN=replace-with-a-long-random-token
TASKMAN_WEB_WORKERS=2

# Local Compose defaults. Use a URL-safe password; it is embedded in TASKMAN_DATABASE_URL.
POSTGRES_USER=taskman
POSTGRES_PASSWORD=taskman
POSTGRES_DB=taskman

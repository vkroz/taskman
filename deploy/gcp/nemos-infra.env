# The Taskman server on Google Cloud project nemos-infra.
# bootstrap.sh, deploy.sh, and the workflow deploy-nemos-infra.yml read this file.
# The scripts read every resource name from this file. The comments describe each
# group. docs/adrs/0001-deploy-the-server-to-google-cloud.md gives the
# design; docs/deploy-gcp.md gives the procedures.

PROJECT_ID=nemos-infra
REGION=us-central1

# Artifact Registry Docker repository and image name. The repository exists in
# nemos-infra.
REPOSITORY=taskman
IMAGE_NAME=taskman

# Cloud SQL for PostgreSQL 16 instance. It exists, and other applications share it.
# bootstrap.sh uses SQL_TIER only when it creates a missing instance.
SQL_INSTANCE=nemos-pg
SQL_TIER=db-custom-1-3840

# The Taskman database on the instance, and its login user.
DB_NAME=taskman
DB_USER=taskman

# Secret Manager secrets: the password of DB_USER, and the client secret of the
# Google OAuth client of browser login.
SECRET_DB_PASSWORD=taskman-db-password
SECRET_GOOGLE_CLIENT=taskman-google-client-secret

# Service accounts (names before @PROJECT_ID.iam.gserviceaccount.com). The deployer
# exists and is reused. The server account runs the schema job and the service.
DEPLOYER_SA=taskman-deployer
SERVER_SA=taskman-server

# Cloud Run resources: the job that runs taskman db upgrade, and the public service.
UPGRADE_JOB=taskman-db-upgrade
SERVICE=taskman

# GitHub deployment: Workload Identity Federation for one repository and branch.
# The pool exists and is reused; the provider admits only this repository and branch.
GITHUB_REPOSITORY=vkroz/taskman
DEPLOY_BRANCH=staging
WIF_POOL=github
WIF_PROVIDER=taskman

# Browser login with Google. It is off while GOOGLE_CLIENT_ID is empty. When it is
# set, ALLOWED_DOMAINS or ALLOWED_EMAILS must also be set: comma-separated, without
# spaces, for example ALLOWED_EMAILS=ana@example.com,ben@example.com.
GOOGLE_CLIENT_ID=
ALLOWED_DOMAINS=
ALLOWED_EMAILS=
